HOST=127.0.0.1
PORT=3000
# Default: deterministic Astra scheduler; no API key or internet required.
SCHEDULER_MODE=simulation
# Optional real model selection via OpenAI Responses API. Both fields are required.
# SCHEDULER_MODE=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=<a model ID available in your OpenAI account>
# GPT-6 Astra is the demo agent label, NOT a hardcoded API model ID.
